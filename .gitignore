# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
gradle-8.1/

# Local configuration file (sdk path, etc)
local.properties

# Log files
*.log
build-logs/

# Android Studio / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Firebase config (per-project config, not a secret, but don't publish it)
app/google-services.json

# Signing keystores & secrets — NEVER commit these
*.jks
*.keystore
keystore.properties
*.p12
*.pem
# Credential tokens — NEVER commit (F1 security fix)
.ghtoken
*token*
*.token

# Cloud Functions deps
firebase-hosting/functions/node_modules/

# Firebase CLI deploy cache (build artifact, regenerated on deploy)
firebase-hosting/.firebase/
.firebase/

# Agent/session scratch (not part of the app)
.agents/
.worktrees/
LOG*.txt
apks*.txt
fs_hits.txt
fscap.txt
gitstatus.txt
install_out.txt
ver_out.txt
