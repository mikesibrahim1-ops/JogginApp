rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Buddy Link — Firestore security rules (design §9)
//
// ⚠ TWO IDENTICAL COPIES: repo-root firestore.rules (canonical/reviewed) and
// firebase-hosting/firestore.rules (the DEPLOY copy, firebase.json → firestore.rules).
// Keep them byte-identical. The Firebase CLI refuses rules paths outside the
// firebase.json directory, so the local deploy copy is required.
//
// Identity model: documents are keyed by our own App ID (a stable UUID), while the
// caller authenticates with a Firebase anonymous uid. The `authMap/{uid}` resolver
// doc maps a caller's uid → their App ID so these rules can authorize App-ID-keyed
// documents. `users/{appId}.authUid` is the reverse mapping used for write checks.
//
// Enforces:
//  - only the owner writes their own user doc / location / blocked / trail;
//  - a location (and its trail) is readable ONLY when an ACCEPTED link exists,
//    BOTH users are `sharing == true`, and NEITHER has blocked the other
//    (CONDITION-1, three-layer enforcement — this is layer 3, tamper-resistant);
//  - link create requires the caller to be side `a`, the target user to exist, and
//    the link to start PENDING; only the recipient (side `b`) can accept it (V1.49).
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Caller's App ID, resolved from their auth uid.
    function myAppId() {
      return get(/databases/$(database)/documents/authMap/$(request.auth.uid)).data.appId;
    }
    function signedIn() { return request.auth != null; }

    function userDoc(appId) {
      return get(/databases/$(database)/documents/users/$(appId)).data;
    }
    // Does `ownerAppId` currently own docs as this caller? (write authorization)
    // authUid now lives in the owner-only users/{appId}/private/self subdoc (design §3.3).
    // A rule get() reads the doc directly and does NOT re-evaluate its allow read, so this
    // is neither recursive nor a self-authorization paradox (design §3.3a).
    function ownsUser(appId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(appId)/private/self).data.authUid == request.auth.uid;
    }
    // Is there an ACCEPTED link between appIdX and appIdY? linkId = sorted pair.
    function linkId(x, y) {
      return x < y ? (x + '_' + y) : (y + '_' + x);
    }
    function acceptedLink(x, y) {
      return exists(/databases/$(database)/documents/links/$(linkId(x, y)))
        && get(/databases/$(database)/documents/links/$(linkId(x, y))).data.state == 'accepted';
    }
    // Any link (pending OR accepted) exists between the pair. Needed so a party can
    // read the counterpart's user doc to show "User X" on a PENDING invite, before
    // acceptance. Reading the user doc exposes only displayName/status, not location
    // (locations stay gated by acceptedLink + mutual sharing below).
    function linkedEitherState(x, y) {
      return exists(/databases/$(database)/documents/links/$(linkId(x, y)));
    }
    function hasBlocked(ownerAppId, otherAppId) {
      return exists(/databases/$(database)/documents/users/$(ownerAppId)/blocked/$(otherAppId));
    }

    // authMap: a caller may only create/read the mapping for their own uid.
    match /authMap/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
                   && request.resource.data.appId is string;
    }

    // Has the caller already registered authMap/{uid} → this appId? (Written FIRST by
    // ensureSession, so a caller can only claim/own the App ID their session maps to.)
    function mappedToMe(appId) {
      return signedIn()
        && exists(/databases/$(database)/documents/authMap/$(request.auth.uid))
        && get(/databases/$(database)/documents/authMap/$(request.auth.uid)).data.appId == appId;
    }

    // users/{appId}
    match /users/{appId} {
      // Readable by the owner, or by anyone who has a link (pending or accepted) with
      // this user — so a pending invite can display the counterpart's name/status.
      allow read: if ownsUser(appId)
                  || (signedIn() && linkedEitherState(myAppId(), appId));
      // Public profile doc now holds only non-sensitive fields (authUid/fcmToken moved
      // to private/self, design §3). Whitelist + type-check; authUid/fcmToken rejected.
      allow create: if mappedToMe(appId)
                    && request.resource.data.keys().hasOnly(
                         ['displayName','photoRef','buddyEnabled','gpsOn','sharing','createdAt','updatedAt'])
                    && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
                    && (!('photoRef' in request.resource.data) || request.resource.data.photoRef is string)
                    && (!('buddyEnabled' in request.resource.data) || request.resource.data.buddyEnabled is bool)
                    && (!('gpsOn' in request.resource.data) || request.resource.data.gpsOn is bool)
                    && (!('sharing' in request.resource.data) || request.resource.data.sharing is bool)
                    && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
                    && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
                    && request.resource.size() < 10;
      // Updates require existing ownership. createdAt is write-once/immutable on update
      // (design §4.3 + §3.5a point 4a): a write carrying a DIFFERENT createdAt on an
      // existing doc is rejected, preserving the real "member since".
      allow update: if ownsUser(appId)
                    && request.resource.data.keys().hasOnly(
                         ['displayName','photoRef','buddyEnabled','gpsOn','sharing','createdAt','updatedAt'])
                    && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
                    && (!('photoRef' in request.resource.data) || request.resource.data.photoRef is string)
                    && (!('buddyEnabled' in request.resource.data) || request.resource.data.buddyEnabled is bool)
                    && (!('gpsOn' in request.resource.data) || request.resource.data.gpsOn is bool)
                    && (!('sharing' in request.resource.data) || request.resource.data.sharing is bool)
                    && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
                    && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
                    && (!('createdAt' in request.resource.data)
                        || !('createdAt' in resource.data)
                        || request.resource.data.createdAt == resource.data.createdAt)
                    && request.resource.size() < 10;
      allow delete: if ownsUser(appId);

      match /blocked/{otherId} {
        allow read, write: if ownsUser(appId);
      }

      // Owner-only sensitive fields (authUid, fcmToken). NEVER readable by a linked or
      // pending party (design §3.4). Create is bootstrapped via authMap (same as the
      // user-doc create); updates are gated by ownership.
      match /private/{docId} {
        allow read: if ownsUser(appId);
        allow create: if mappedToMe(appId)
                      && docId == 'self'
                      && request.resource.data.authUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['authUid', 'fcmToken', 'updatedAt'])
                      && request.resource.data.authUid is string
                      && (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string)
                      && request.resource.size() < 4;
        allow update: if ownsUser(appId)
                      && docId == 'self'
                      && request.resource.data.authUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['authUid', 'fcmToken', 'updatedAt'])
                      && request.resource.data.authUid is string
                      && (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken is string)
                      && request.resource.size() < 4;
        allow delete: if ownsUser(appId);
      }
    }

    // links/{linkId}: either party may read/update/delete; creator must be side `a`.
    // NOTE: the creator is side `a` and may be inviting a stranger `b`, whose
    // users/{b}/blocked/* subtree the creator cannot read. Calling hasBlocked(b, me)
    // here throws PERMISSION_DENIED (get/exists on an unreadable path errors, it does
    // not return false), which blocked the code-based invite entirely. The block is
    // instead enforced where it is readable: the recipient (side `b`) can decline, and
    // location reads are already gated by hasBlocked on both sides.
    // The doc-id wildcard is `lid` (not `linkId`) so it doesn't shadow the linkId()
    // function, which the create rule calls.
    match /links/{lid} {
      // Single-doc read: a MISSING doc (resource == null) reveals nothing, and must be
      // readable so the creator's transaction can tx.get() it before creating (V1.49).
      allow get: if signedIn()
        && (resource == null
            || myAppId() == resource.data.a || myAppId() == resource.data.b);
      // Queries (observeBuddies / observePendingRequests / deleteAllMyData) must be
      // constrained to links where I'm a party.
      allow list: if signedIn()
        && (myAppId() == resource.data.a || myAppId() == resource.data.b);
      allow create: if signedIn()
        && request.resource.data.a == myAppId()
        // Forbid forged ids: the doc id must be the sorted pair.
        && lid == linkId(request.resource.data.a, request.resource.data.b)
        // No self-link.
        && request.resource.data.b != myAppId()
        // SECURITY: a link is always born PENDING; it can't be created already accepted.
        && request.resource.data.state == 'pending'
        // The target must exist (replaces the removed client-side users/{b} precheck).
        && exists(/databases/$(database)/documents/users/$(request.resource.data.b));
      allow update: if signedIn()
        && (myAppId() == resource.data.a || myAppId() == resource.data.b)
        // The parties of a link are immutable.
        && request.resource.data.a == resource.data.a
        && request.resource.data.b == resource.data.b
        // State: unchanged (re-request counter bump), or either party declines/removes,
        // or ONLY the recipient (side b) accepts a PENDING link.
        && (request.resource.data.state == resource.data.state
            || request.resource.data.state in ['declined', 'removed']
            || (request.resource.data.state == 'accepted'
                && resource.data.state == 'pending'
                && myAppId() == resource.data.b))
        // ── ADDED (F3): alert-cap tamper resistance (design §4.4). reqWindowStart is
        // monotonic non-decreasing; reqCount may stay equal, bump by exactly 1, or reset
        // to 1 only when the window advances. Guards short-circuit for writes that omit
        // these fields (accept/decline/remove only touch state/updatedAt).
        && (!('reqWindowStart' in request.resource.data)
            || !('reqWindowStart' in resource.data)
            || request.resource.data.reqWindowStart >= resource.data.reqWindowStart)
        && (!('reqCount' in request.resource.data)
            || !('reqCount' in resource.data)
            || request.resource.data.reqCount == resource.data.reqCount
            || request.resource.data.reqCount == resource.data.reqCount + 1
            || (request.resource.data.reqCount == 1
                && request.resource.data.reqWindowStart > resource.data.reqWindowStart));
      allow delete: if signedIn()
        && (myAppId() == resource.data.a || myAppId() == resource.data.b);
    }

    // locations/{appId}: owner writes; accepted+mutually-sharing+unblocked buddies read.
    match /locations/{appId} {
      // Owner write with field/size/type/range validation (design §4.1). On-demand
      // requests live in the locReq subcollection (§5), NOT on this doc.
      allow write: if ownsUser(appId)
        && request.resource.data.keys().hasOnly(['lat', 'lon', 'at', 'expireAt'])
        && request.resource.data.lat is number
        && request.resource.data.lon is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
        && request.resource.data.at is timestamp
        && request.resource.data.expireAt is timestamp
        && request.resource.size() < 8;
      allow read: if signedIn()
        && acceptedLink(myAppId(), appId)
        && userDoc(appId).sharing == true
        && userDoc(myAppId()).sharing == true
        && !hasBlocked(appId, myAppId())
        && !hasBlocked(myAppId(), appId);

      match /trail/{point} {
        allow write: if ownsUser(appId)
          && request.resource.data.keys().hasOnly(['lat', 'lon', 'at', 'expireAt'])
          && request.resource.data.lat is number
          && request.resource.data.lon is number
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
          && request.resource.data.at is timestamp
          && request.resource.data.expireAt is timestamp
          && request.resource.size() < 6;
        allow read: if signedIn()
          && acceptedLink(myAppId(), appId)
          && userDoc(appId).sharing == true
          && userDoc(myAppId()).sharing == true
          && !hasBlocked(appId, myAppId())
          && !hasBlocked(myAppId(), appId);
      }

      // On-demand location-request markers (design §5, F10). Owner reads incoming
      // requests; an accepted, mutually-sharing, unblocked buddy may create ONLY their
      // own marker (key == their appId), shape- and size-limited. The write gate reuses
      // CONDITION-1 exactly, so it cannot broaden location-read access.
      match /locReq/{requesterAppId} {
        allow read: if ownsUser(appId);
        allow create, update: if signedIn()
          && requesterAppId == myAppId()
          && acceptedLink(myAppId(), appId)
          && userDoc(appId).sharing == true
          && userDoc(myAppId()).sharing == true
          && !hasBlocked(appId, myAppId())
          && !hasBlocked(myAppId(), appId)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is timestamp
          && request.resource.size() < 3;
        allow delete: if ownsUser(appId) || requesterAppId == myAppId();
      }
    }
  }
}
