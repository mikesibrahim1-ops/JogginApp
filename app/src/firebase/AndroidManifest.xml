<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Firebase-enabled manifest overlay. This file is used as the app manifest ONLY when
      app/google-services.json is present (build.gradle swaps main.manifest.srcFile to
      this file when firebaseEnabled). It is a copy of src/main/AndroidManifest.xml PLUS
      the Buddy Link FirebaseMessagingService (which requires the gated firebase source
      set + firebase-messaging dependency, so it can't live in the base manifest).

      ⚠ KEEP IN SYNC with src/main/AndroidManifest.xml — if you change permissions,
      activities, providers, or services there, mirror the change here.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:allowBackup="true"
        android:label="Joggin"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Buddy Link invite deep link: joggin://buddy/v1/<appId>?exp=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="joggin" android:host="buddy" />
            </intent-filter>
            <!-- Buddy Link invite https fallback (Firebase Hosting): https://joggin-a69a7.web.app/buddy?id=...&exp=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="joggin-a69a7.web.app" android:pathPrefix="/buddy" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.joggingapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".ForegroundLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service
            android:name=".BuddyLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Buddy Link push receiver (FCM). Only present in the Firebase-enabled build. -->
        <service
            android:name=".BuddyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
