# Release signing credentials — COPY this file to `keystore.properties` and fill it in.
#
#   cp app/keystore.properties.example app/keystore.properties
#
# `keystore.properties` is gitignored (see .gitignore) and MUST NOT be committed.
# These values are read by app/build.gradle to sign the `release` build type.
#
# Alternatively, set the equivalent environment variables (used as a fallback,
# preferred for CI): JOGGIN_KEYSTORE_PATH, JOGGIN_KEYSTORE_PASSWORD,
# JOGGIN_KEY_ALIAS, JOGGIN_KEY_PASSWORD.
#
# If neither a keystore.properties nor the env vars resolve to an existing keystore
# file, the release build still succeeds but produces an UNSIGNED release APK
# (a warning is printed). Debug builds are unaffected.

# Path to the release keystore, relative to the app/ module directory.
# e.g. ../joggin-release.jks  (keystore at the repo root)
storeFile=../joggin-release.jks

# Keystore (store) password.
storePassword=CHANGE_ME

# Key alias inside the keystore.
keyAlias=joggin

# Password for the key alias (often the same as storePassword).
keyPassword=CHANGE_ME
